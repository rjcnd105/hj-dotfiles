{
	"mcpServers": {
		"codegraph": {
			"command": "codegraph",
			"args": [
				"serve",
				"--mcp"
			],
			"exposure": "codemode",
			"description": "Symbol graph and verbatim source for repos that have a .codegraph/ index"
		},
		"godot-ai": {
			"command": "/Users/hj/.local/share/mise/installs/uv/latest/uv-aarch64-apple-darwin/uvx",
			"args": [
				"--isolated",
				"--no-config",
				"--no-env-file",
				"--no-sources",
				"--no-build",
				"--index-strategy",
				"first-index",
				"--keyring-provider",
				"disabled",
				"--index",
				"https://pypi.org/simple",
				"--default-index",
				"https://pypi.org/simple",
				"--find-links",
				"https://pypi.org/simple/godot-ai/",
				"--link-mode",
				"copy",
				"--from",
				"godot-ai==4.3.0",
				"godot-ai",
				"attach",
				"--port",
				"8000",
				"--ws-port",
				"9500"
			]
		}
	}
}