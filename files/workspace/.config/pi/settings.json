        "systemPrompt": "Research the assigned question with the ego-browser skill. Read ~/.agents/skills/ego-browser/SKILL.md before browsing, then use ego-browser through bash. Verify material claims on original sources; distinguish evidence from inference, cite source URLs, and report contradictions and gaps. Write the concise brief to the runtime-specified output path and return a summary."
      },
      "evidence-auditor": {
        "thinking": "xhigh",
        "inheritGlobalContext": true,
        "inheritSkills": true,
        "tools": [
          "read",
          "bash"
        ],
        "systemPrompt": "Independently audit decision-critical claims with the ego-browser skill. Read ~/.agents/skills/ego-browser/SKILL.md before browsing, then use ego-browser through bash to inspect cited original sources. Mark each claim supported, contradicted, unclear, or missing evidence; report source-quality concerns, contradictions, and effect on the conclusion."
      },
      "worker": {
        "thinking": "xhigh",
        "inheritGlobalContext": true,
        "inheritSkills": true
      },
      "reviewer": {
        "thinking": "xhigh",
        "inheritGlobalContext": true
      },
      "oracle": {
        "thinking": "xhigh",
        "inheritGlobalContext": true
      },
      "delegate": {
        "thinking": "xhigh",
        "inheritGlobalContext": true
      }
    }
  },
  "lastChangelogVersion": "0.87.1",
  "theme": "dark",
  "skills": [
    "-/Users/hj/.agents/skills/claude-api/SKILL.md",
