{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(env)",
      "Bash(gh *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(grep *)",
      "Bash(grep -r *)",
      "Bash(jj diff *)",
      "Bash(jj log *)",
      "Bash(jj show *)",
      "Bash(jj status)",
      "Bash(just *)",
      "Bash(ls *)",
      "Bash(mise *)",
      "Bash(mkdir *)",
      "Bash(nix eval *)",
      "Bash(nix flake *)",
      "Bash(nixfmt *)",
      "Bash(node *)",
      "Bash(which *)",
      "WebFetch",
      "WebSearch"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5",
  "enabledMcpjsonServers": [
    "chrome-devtools",
    "context7",
    "node_repl"
  ],
  "disabledMcpjsonServers": [
    "openaiDeveloperDocs"
  ],
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": false,
    "honey@greenpt": true,
    "typescript-lsp@claude-plugins-official": true,
    "agent-skills@addy-agent-skills": true,
    "frontend-design@claude-plugins-official": true,
    "cyclomatic-complexity@cyclomatic-complexity-skill": true
  },
  "extraKnownMarketplaces": {
    "greenpt": {
      "source": {
        "source": "github",
        "repo": "Green-PT/honey-for-devs"
      },
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      },
      "autoUpdate": true
    },
    "cyclomatic-complexity-skill": {
      "source": {
        "source": "github",
        "repo": "saurabhkumar8112/cyclomatic-complexity-skill"
      }
    }
  },
  "language": "Korean",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    }
  },
  "askUserQuestionTimeout": "never",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "normal",
  "verbose": true,
  "skipAutoPermissionPrompt": true
}
