{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(env)",
      "Bash(gh *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(grep *)",
      "Bash(grep -r *)",
      "Bash(jj diff *)",
      "Bash(jj log *)",
      "Bash(jj show *)",
      "Bash(jj status)",
      "Bash(just *)",
      "Bash(ls *)",
      "Bash(mise *)",
      "Bash(mkdir *)",
      "Bash(nix eval *)",
      "Bash(nix flake *)",
      "Bash(nixfmt *)",
      "Bash(node *)",
      "Bash(which *)",
      "WebFetch",
      "WebSearch",
      "Bash(/Users/hj/.local/bin/mise generate:*)",
      "Bash(jj help:*)",
      "Bash(jj --version)",
      "Bash(export PATH=\"/Users/hj/.local/share/mise/installs/jj/0.40.0:$PATH\")",
      "Read(//Users/hj/dot/nix-dots/**)",
      "Bash(jj commit:*)",
      "Bash(claude plugin:*)"
    ],
    "defaultMode": "auto"
  },
  "language": "Korean",
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "verbose": true,
  "skipAutoPermissionPrompt": true
}
