{
	"mcpServers": {
		"godot-ai": {
			"command": "/Users/hj/.local/share/mise/installs/uv/latest/uv-aarch64-apple-darwin/uvx",
			"args": [
				"--isolated",
				"--no-config",
				"--no-env-file",
				"--no-sources",
				"--no-build",
				"--index-strategy",
				"first-index",
				"--keyring-provider",
