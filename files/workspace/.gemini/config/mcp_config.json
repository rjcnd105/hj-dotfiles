				"--exclude-newer-package",
				"godot-ai=false",
				"--python",
				">=3.11,<3.15",
				"--index",
				"https://pypi.org/simple",
				"--default-index",
				"https://pypi.org/simple",
				"--find-links",
				"https://pypi.org/simple/godot-ai/",
				"--link-mode",
				"copy",
				"--from",
				"godot-ai==4.4.2",
				"godot-ai",
				"attach",
				"--port",
				"8000",
				"--ws-port",
				"9500"
			],
			"disabled": false
		},
		"hindsight": {
			"command": "node",
			"args": [
				"--preserve-symlinks-main",
				"/Users/hj/.hindsight/coding-agents/dist/mcp-server.js"
			],
			"env": {
				"HINDSIGHT_MCP_HARNESS": "antigravity-cli"
			}
		}
	}
