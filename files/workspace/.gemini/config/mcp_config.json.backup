{
  "mcpServers": {
    "godot-ai": {
      "command": "/Users/hj/.local/share/mise/installs/uv/latest/uv-aarch64-apple-darwin/uvx",
      "args": [
        "--isolated",
        "--no-config",
        "--no-env-file",
        "--no-sources",
        "--no-build",
        "--index-strategy",
        "first-index",
        "--keyring-provider",
        "disabled",
        "--exclude-newer",
        "2026-11-03T00:46:44Z",
        "--exclude-newer-package",
        "godot-ai=false",
        "--index",
        "https://pypi.org/simple",
        "--default-index",
        "https://pypi.org/simple",
        "--find-links",
        "https://pypi.org/simple/godot-ai/",
        "--link-mode",
        "copy",
        "--from",
        "godot-ai==4.4.1",
        "godot-ai",
        "attach",
        "--port",
        "8000",
        "--ws-port",
        "9500"
      ],
      "disabled": false
    },
    "hindsight": {
      "command": "node",
      "args": [
        "--preserve-symlinks-main",
        "/Users/hj/.hindsight/coding-agents/dist/mcp-server.js"
      ],
      "env": {
        "HINDSIGHT_MCP_HARNESS": "antigravity-cli"
      }
    }
  }
}
